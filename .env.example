# Copier vers .env puis remplacer les valeurs « replace_* » avant le lancement.
# Les mots de passe SEED_* ci-dessous sont des identifiants publics de démonstration locale uniquement.
SECRET_KEY=replace_with_a_long_random_secret
SESSION_COOKIE_SECURE=false
DEBUG=false
APP_PORT=5000

DB_HOST=postgres
DB_PORT=5432
DB_NAME=medicare
DB_USER=medicare
DB_PASSWORD=replace_local_database_password
DB_SSLMODE=prefer
DB_SSLROOTCERT=

S3_BUCKET=medicare-documents
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
AWS_REGION=eu-west-3
S3_ACCESS_KEY=replace_local_minio_user
S3_SECRET_KEY=replace_local_minio_password

# Valeurs de démonstration locales, obligatoires pour initialiser seed.py.
SEED_ADMIN_PASSWORD=AdminDemo123!
SEED_DOCTOR1_PASSWORD=AmiraDemo123!
SEED_DOCTOR2_PASSWORD=YassineDemo123!
SEED_SECRETARY_PASSWORD=Secretariat123!
SEED_PATIENT_PASSWORD=PatienteDemo123!

# Utiliser Redis/ElastiCache en production multi-processus ou multi-instance.
RATELIMIT_STORAGE_URI=memory://